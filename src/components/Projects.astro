<section class='bg-[#13151a] w-full grid grid-cols-9 pb-5'>
  <!-- Título en la columna central -->
  <h2 class='text-2xl font-bold self-center col-start-3 row-start-1 py-4'>Proyectos</h2>

  <!-- Contenedor para los proyectos en la columna del medio -->
  <div class='grid 2xl:grid-cols-3 sm:grid-cols-2 xs:grid-cols-1 gap-y-8 row-start-2 col-start-3 xs:col-end-8 2xl:col-end-7 sm:col-end-8 gap-5'>
    <!-- Segundo Proyecto -->
    <div class='bg-[#1e293b] rounded-lg max-w-xs p-5 flex flex-col h-full'>
      <img class='rounded-[25px] w-full h-40 object-cover' src='/urls.webp' alt='imagen de proyecto acortador de urls' />
      <h3 class='font-bold'>Acortador de Urls</h3>
      <p class='font-bold text-gray-500'>Proyecto de un acortador de url</p>
      <div class='flex flex-row space-x-2 mt-auto mb-1 items-center'>
        <img src='/react.svg' width='25' height='25' alt='logo de react' />
        <img src='/node.svg' width='25' height='25' alt='logo de nodejs' /><!-- iconos de tecnologías usadas -->
      </div>
      <button class='bg-orange-500 w-full rounded-3xl text-[#13151a] font-bold p-2 flex items-center justify-center gap-2 mt-0' onclick='location.href="http://url.wandev.top"'>
        <span>Ver proyecto</span>
      </button>
    </div>

    <!-- Tercer Proyecto -->
    <div class='bg-[#1e293b] rounded-lg max-w-xs p-5 flex flex-col h-full'>
      <img class='rounded-[25px] w-full h-40 object-cover' src='/peliculas.webp' alt='imagen de proyecto de busqueda indexada sobre peliculas' />
      <h3 class='font-bold'>Busqueda indexada</h3>
      <p class='font-bold text-gray-500'>Proyecto SPA de busqueda indexada con un dataset de 40 mil peliculas</p>
      <div class='flex flex-row space-x-2 mb-1 mt-auto items-center'>
        <img src='/react.svg' width='25' height='25' alt='logo de react' />
        <img src='/node.svg' width='25' height='25' alt='logo de nodejs' /><!-- iconos de tecnologías usadas -->
      </div>
      <button class='bg-orange-500 w-full rounded-3xl text-[#13151a] font-bold p-2 flex items-center justify-center self-end gap-2 mt-auto' onclick='location.href="http://indexsearch.wandev.top"'>
        <span>Ver proyecto</span>
      </button>
    </div>
  </div>
</section>
